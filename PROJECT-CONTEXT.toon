meta:
  file: PROJECT-CONTEXT.toon
  purpose: "Onboarding context map of this codebase: routes, services, API health, blockers. One of four files - see companions."
  read_first: "BIBLE.md, NOT this file. BIBLE.md is the contract and points here for route/service/API detail."
  companions: "BIBLE.md (the rules), COMPONENTS.toon (generated component inventory), STYLING.toon (the visual contract)"
  format: TOON
  updated: 2026-09-23
  cadence: "twice monthly"
  next_review: 2026-10-07
  scope: "This repo is the frontend portal ONLY. The API is a separate .NET repo (acnnewswire-api) not present here."
  rot_warning: "Sections api_health, blockers and current_steps go stale fastest - re-verify those every update. Structure sections (routes, services) change slowly. COMPONENT structure is no longer described here at all: COMPONENTS.toon is generated from the import graph and cannot go stale."
  refresh_how: "Probe api_health with curl against the swagger list; re-read docs/api-schemas/_gaps.csv; re-run git log since the updated date above. Component rows need no refresh - run npm run components:map instead."
  last_change: "2026-09-23 - migrated onto the new /full API routes. services/events.ts reads /api/Events/full and /api/Events/{id}/full (one request, no page sweep, no unstable_cache, no date/url/image repair); services/company-profile.ts reads /api/Companies/{id}/full (one request, was two). App-facing models deliberately UNCHANGED. /api/Sectors probed but not wired - see docs/sectors-probe-2026-09-23.md."

project:
  name: acn-newswire-portal
  version: 1.0.0
  what: "Public newsroom / press-release portal for ACN Newswire"
  root: "D:\\acn-newswire-admin\\newsroom-main"
  branch: main
  deploy_url: portal.acnnewswire.com
  deploy_host: Netlify
  deploy_config_in_repo: false
  deploy_config_note: "No netlify.toml, _redirects or _headers exist. Build command, env vars and the Next runtime plugin are configured in the Netlify dashboard only - this repo cannot tell you what deploy does."
  backend: "acnnewswire-api - .NET + EF Core + SQL Server, separate repo, separate team"

stack[12]{layer,choice,version,note}:
  framework,"Next.js App Router",^16.2.6,"RSC. No middleware.ts, no error.tsx, no loading.tsx, no sitemap.ts, no robots.ts anywhere"
  ui,React,19.2.3,"react-dom 19.2.3"
  styling,"Tailwind CSS v4",^4,"via @tailwindcss/postcss, plus 4 co-located GLOBAL .css files. No CSS Modules anywhere"
  language,TypeScript,^5,-
  sanitizer,dompurify,^3.4.7,"plain dompurify NOT isomorphic-dompurify. Client-only, used in Body.tsx alone"
  ab_storage,@upstash/redis,^1.38.3,"A/B vote tallies in prod; falls back to a local JSON file when env unset"
  slugs,transliteration,^2.6.1,"slugify() at services/acn-adapter.ts:6 for headline slugs"
  server_guard,server-only,^0.0.1,"guards every src/ab/* module"
  linting,"eslint + eslint-config-next","^10.0.0 / ^0.2.4","npm run lint is BROKEN - see commands.lint. Never ran clean in this state."
  react_compiler,babel-plugin-react-compiler,1.0.0,"devDep INSTALLED BUT DISABLED - commit 1ab5299 commented out reactCompiler:true as a hotfix"
  i18n,next-intl,^4.8.3,"INSTALLED BUT NEVER IMPORTED - dead dependency, safe to remove"
  testing,none,-,"No test script, no runner installed. See lib.__tests__ rows"

commands[9]{cmd,runs,note}:
  dev,"next dev","local dev server"
  build,"next build","Netlify runs this; starts with an EMPTY .next cache"
  start,"next start","serve built output"
  lint,eslint,"BROKEN - the ajv ^8.18.0 override in package.json is incompatible with eslint@10, which wants ajv/lib/refs/json-schema-draft-04.json. Pre-existing. tsc --noEmit and next build are the real gates."
  components:map,"node scripts/gen-components.mjs","Regenerates COMPONENTS.toon from the real import graph. Runs automatically on commit once you set git config core.hooksPath .githooks"
  components:check,"node scripts/gen-components.mjs --check","Exits 1 if COMPONENTS.toon is stale. This is the CI gate."
  prefetch-articles-new,"node scripts/prefetch-articles.mjs","MANUAL ONLY, not in package.json. Rebuilds the /search snapshot from the NEW API. SUPERSEDES scripts/prefetch-articles.js, which sweeps legacy ids and cannot run while that host is 503. Caps at the 5000 most recent articles - the corpus is 20000+ and this file is bundled"
  probe-events-schema,"node scripts/probe-events-schema.mjs","MANUAL ONLY, not in package.json. Re-exports the EVENTS schema surface into docs/api-schemas (4 CSVs plus the Event rows of _index.csv and _field-dictionary.csv). Idempotent; leaves other entities untouched"
  prefetch,"node scripts/prefetch-articles.js","OBSOLETE - sweeps legacy ids 107000-107303 against a host that has been 503 since 2026-08-27, and those ids no longer exist. Use prefetch-articles.mjs instead"

env[8]{name,read_at,status,purpose}:
  AB_USERS,src/ab/config.ts:20,active,"user:password pairs for employee A/B login"
  AB_ADMINS,src/ab/config.ts:21,active,"usernames allowed at /admin"
  AB_SECRET,src/ab/config.ts:22,active,"HMAC key signing the A/B session cookie"
  UPSTASH_REDIS_REST_URL,src/ab/store.ts:27,optional,"unset locally, so store falls back to .ab-data/store.json"
  UPSTASH_REDIS_REST_TOKEN,src/ab/store.ts:27,optional,"pairs with the URL above"
  NEXT_PUBLIC_SITE_URL,"src/lib/metadata.ts:6 + src/app/api/og/article/[id]/route.tsx:4",active,"canonical and OG urls ONLY - does not affect data fetching"
  USE_MOCK,src/services/index.ts:6,DEAD,"index.ts has zero importers, so this gate is unreachable"
  NEXT_PUBLIC_API_BASE_URL,nowhere,TRAP,"README documents it as the backend switch but NO CODE READS IT. Setting it in Netlify does nothing. API hosts are hardcoded per service file"

api_hosts[5]{role,host,note}:
  new_api,https://development.acnnewswire.com,"Primary. HARDCODED in 6 service files, no env indirection. Note the name says development but it is what production uses"
  legacy_api,https://www.acnnewswire.com/acnnewswireapi,"Enrichment fields + the company archive feed. Also hardcoded"
  photos,https://photos.acnnewswire.com,"article images - whitelisted in next.config.ts"
  company_logos,https://www.acnnewswire.com/images/company,"whitelisted in next.config.ts"
  event_images,https://www.acnnewswire.com/eventimages,"NOT whitelisted in next.config.ts - next/image would reject these"

api_health:
  probed: 2026-09-23
  probed_prev: 2026-09-10
  summary: "The API team SHIPPED the contracts/ reconciliation. Four new paths (17, was 13): /api/Events/full, /api/Events/{id}/full, /api/Companies/{id}/full and /api/Sectors. The events ARCHIVE IS BACK - 816 published of 839, with organisers populated - and /api/Events/{id}/full is a working single-event read at last. The plaintext username/password leak is FIXED on every company route. This repo now reads /api/Events/full and /api/Companies/{id}/full; see services below. Legacy API host still fully DOWN (503)."
  changed_since_2026_09_10: "Everything under `new` was re-probed on 2026-09-23. The /full routes are the contracts/*.after.json shapes delivered as SEPARATE paths rather than as changes to the originals, so both shapes are live and the old quirks persist on the old paths - /api/Events still ships 2.65MB with the 167-times organiser repetition, and /api/Events/{id} still 500s. Nothing was removed. The service-layer cutover is in git; the sector comparison is in docs/sectors-probe-2026-09-23.md."
  full_routes_caution: "The /full projections are PUBLISHED-ONLY. /api/Events/full returns 816 rows, not 839: the 23 events the wire marks unpublished (ids 75 112 113 121 140 152 191 194 195 196 198 201 204 207 208 209 307 405 436 487 755 856 858) are absent, and 404 on /api/Events/{id}/full. Correct for this site, which shows published events only. acn-admin still sweeps the legacy /api/Events alongside /full for exactly this reason."
  events_caution: "SUPERSEDED 2026-09-23. The archive is restored: 839 rows on the legacy path, 816 published on /full, spanning 2007-11-18 to 2026-12-02. compId/organiserId is populated on 108 of them - null on the other 708, which is the real shape of the data rather than a fault. The 167-times organiser repetition is gone from /full (deduped server-side) and still present on the legacy path. PageSize on /api/Events/full is NOT capped at 100."
  probe_note: "Probe with REAL ids from the list endpoints (articles 106624-106708, companies 14/82/574, events 17-23/163/177/178) - a 404 from a missing record otherwise reads as breakage. The dev host 403s a bare urllib/python User-Agent; curl works."
  endpoints[17]{path,host,status,detail}:
    /swagger/v1/swagger.json,new,200,"API is alive, 17 paths published (was 13). The four new ones are the three /full projections plus /api/Sectors"
    /api/Articles,new,200,"works. 80,602 articles over 807 pages. CAUTION: SecId and ArtType are accepted and SILENTLY IGNORED - filtered results are byte-identical to unfiltered, so a filter built on either looks like it works and does not. Only HasThumbnail filters. Cid is a SOURCE id, not a company id"
    /api/Articles/homepage,new,200-EMPTY,"returns [] so news-list.ts deliberately reads /api/Articles instead"
    /api/Articles/by-industry,new,200,"400s without the REQUIRED industry param and returns real rows with it"
    /api/Articles/search,new,200,"returns a flat 34-key article x company x exchange JOIN row with no companies[] and no images[], a different shape from every other article endpoint. Page is ignored: a fixed 10-row window comes back every time. Takes ExchangeId/SectorName/CompanyName/TickerId/Country - there is still NO keyword param, so it cannot back /search"
    /api/Articles/press-release/{id},new,200,"sectors arrives as a real ARRAY, not a JSON-encoded string"
    /api/Articles/by-company/{id},new,200,"pageNumber/pageSize paginate correctly"
    /api/Companies,new,200,"works, takes Page/Size. Size is capped at 100 - 101 is a 400. username/password NO LONGER RETURNED"
    /api/Companies/{id},new,200,"works. Superseded for this repo by /full. username/password NO LONGER RETURNED"
    /api/Companies/{id}/details,new,200,"works, and is now redundant - every field it carries is on /full. Kept probed because it is still the only endpoint that could ever carry an address"
    /api/Companies/{id}/full,new,200,"NEW. The whole company in ONE request: names{} nested by language tag, absolute logos, boilerplate + boilerplateExtended, socials{} as one object, profile{} (the former /details), sectors/tickers/bloombergCodes/rss/contacts, annualReport{}. contacts[] carries the RICH shape that used to need /api/CompContacts - HKTDC returns 63 of them. sectors and tickers are byte-identical to the detail route. No credentials. This is what company-profile.ts reads"
    /api/CompContacts,new,200,"back in the spec (it had been reshuffled out). No longer needed by either repo - /full embeds the same rows with the same fields"
    /api/Events,new,200,"the LEGACY shape, unchanged and still quirky: 839 rows, 2.65MB for the full sweep because the organiser repeats once per release (167 copies on the worst row), offsetless midnight dates, scheme-less url, bare-filename image, publish as the string y. Still the ONLY place the 23 unpublished events exist, which is why acn-admin still sweeps it. This repo no longer calls it"
    /api/Events/{id},new,500,"STILL BROKEN - 'The required column Companies was not present'. The fix landed on /full, NOT here. Do not call it"
    /api/Events/full,new,200,"NEW, and what services/events.ts now reads. The reconciled shape: name (was description), real +08:00 offsets, endDate at 23:59:59, absolute url and photo, isPublished boolean, organiserId/organisers[] deduped. 816 published rows in ONE request at 286KB - against 2.65MB for the same data on the legacy path. PageSize is UNCAPPED (2000 works). Server-side Upcoming/From/To filters, all verified"
    /api/Events/{id}/full,new,200,"NEW. The working single-event read - closes AE-M5. 404s for an unpublished id as well as an unknown one"
    /api/Events/company/{id}/year/{year},new,200,"works and IS the event-to-release relation. Unchanged, but it can finally resolve: organiserId now arrives populated on the 108 events that have one"
    /api/Sectors,new,200,"NEW. 199 sectors with id, subId and ja/zh-Hans/zh-Hant/ko titles, 40KB, no paging. NOT WIRED UP - probe only, by decision. The local 76-row list is a strict subset by name, but 52 of 85 shared names disagree on id and 35 wire ids resolve to a DIFFERENT local industry. Full analysis: docs/sectors-probe-2026-09-23.md"
  legacy[2]{path,status,detail}:
    /api/v1/News/GetArticleById/{id},503,"Whole legacy host still down. Enrichment only now - supplies language, location, views, supplier, url"
    /api/v1/Company/GetNewsByCompanyId/{id},503,"NO LONGER USED - company-articles.ts was cut over to the new API on 2026-09-08"

local_vs_deployed:
  status: "RESOLVED 2026-09-08 at the source - the backend fixed the Sectors 500, so article detail works from a cold cache. Kept because the mechanism will bite again the next time an endpoint breaks."
  verify: "The stale fetch-cache on this machine was cleared and a full build re-run against the live API on 2026-09-08; all routes returned 200. If articles 404 again, this is still the first thing to rule out."
  question: "Why do articles render on localhost but 404 on portal.acnnewswire.com?"
  answer: "Stale Next.js fetch cache on the dev machine, which is gitignored and never deployed."
  mechanism[5]{step,detail}:
    1,"Every article fetch uses next.revalidate 3600 (src/services/press-release.ts:33) - no cache:no-store anywhere"
    2,".next/cache/fetch-cache on this machine holds 21 cached responses, newest 2026-08-27 20:02, captured while the endpoint still worked"
    3,"Next serves that stale entry when background revalidation fails (stale-on-error), so localhost still renders articles"
    4,"/.next/ is gitignored at .gitignore:17, so a Netlify build starts with an empty cache and hits the live 500 directly"
    5,"fetchPressRelease throws at src/services/press-release.ts:39-41, the page catch converts it to notFound() at src/app/article/[...segments]/page.tsx:117, and the visitor sees a 404"
  not_the_cause[4]{ruled_out,why}:
    "Netlify config","No netlify.toml exists and the site itself returns 200"
    "repo connection","Deploy pipeline is fine, the build succeeds"
    "frontend code","Same code renders correctly against cached data"
    "NEXT_PUBLIC_API_BASE_URL","Read by no code - changing it in Netlify has zero effect"
  what_still_works_when_deployed[3]{route,why}:
    /search,"Reads the bundled 292-article JSON snapshot, makes zero network calls"
    /events/<slug>,"Event detail pages are served entirely from src/data/mock-events.ts"
    /company/<id>,"Profile cards render (Companies endpoints are healthy) but the release feed is empty because its legacy source is 503"

routes:
  note: "Zero route-segment config exports exist anywhere in src/app. All caching is set at the fetch() call site."
  pages[12]{file,url,kind,data,renders,notes}:
    src/app/layout.tsx,"(wraps all)",server,generateBaseMetadata,"TopNav, MainNav, children, Footer, AbOverlay in Suspense","Inter via next/font"
    src/app/page.tsx,/,server,"fetchHeroSlides, fetchEvents, fetchPressRelease x5, fetchArticlesByIndustry","HomeHero, EventsRow, FeaturedReleases, CategoryRow xN","5 HARDCODED featured ids: 85791 107246 107300 107292 107230. Every fetch has .catch(->[]) so the page never throws, it just renders empty"
    src/app/article/[...segments]/page.tsx,/article/*,server,"fetchPressRelease, fetchCompanyArticles, fetchReleaseVersions","PressRelease, InfiniteArticleFeed, NewsArticle JSON-LD","Canonical shape /article/<lang>/<id>/<slug>, other shapes 308-redirect in. Two separate segment parsers that must agree (extractId at :16 for metadata, inline destructure at :46 for render). Imports the PRIVATE Next internal next/dist/client/components/redirect-error at :4 - upgrade-fragile"
    src/app/company/[id]/page.tsx,"/company/<id>?page=N",server,"fetchCompanyProfile, fetchCompanyArticlesPage","PressReleaseItem xN, CompanyPagination, CompanySidebar","PAGE_SIZE 15. generateMetadata refetches the profile, deduped only by the fetch cache not React cache()"
    src/app/events/page.tsx,/events,server,"fetchEvents, listMockEvents","EventListCard, Link rows","MIXES live API events with mock featured events on one page. Live rows now link INTERNALLY to /events/<id> instead of straight out to the organiser site"
    src/app/events/[eventId]/page.tsx,"/events/<slug> and /events/<id>",server,"getMockEvent, else fetchEvent + fetchEventReleases","curated: Hero, StatBand, EventReleaseItem, Rail*. live: ./LiveEvent.tsx","TWO-STEP RESOLVE as of 2026-09-08: a mock slug renders the curated page unchanged; anything else is looked up against the live API and rendered by LiveEvent.tsx. Only ids the API does not know 404 now. generateStaticParams still prerenders the 4 curated slugs"
    src/app/events/[eventId]/press-releases/page.tsx,/events/<id>/press-releases,server,"fetchEvents, fetchPressRelease xN",PressReleaseItem,"ORPHAN - nothing links here because events.ts:53 pins pressReleaseUrl to null. Only event 1119 is mapped"
    src/app/news/page.tsx,"/news?page&limit",server,fetchNewsList,"PressReleaseItem + prev/next","hasNext is a heuristic (articles.length === limit); the API returns no total count"
    src/app/search/page.tsx,"/search?q&page&limit&sec&lang&reg",server,searchArticles,"SearchSidebar, SearchResults","NO NETWORK - filters the bundled JSON snapshot in-process. ?country= is emitted by the nav but never parsed here, so country links return unfiltered results"
    src/app/search/layout.tsx,/search,server,none,children,"Its metadata export is DEAD - the page's generateMetadata wins"
    src/app/not-found.tsx,(404),server,none,"static markup","Target of every notFound() call"
    src/app/admin/page.tsx,/admin,server,getSession,AdminPanel,"notFound() for non-admins (404 not 403). noindex. Login only via the F2 overlay, there is no login form here"
  api[10]{file,method_url,wraps,notes}:
    src/app/api/press-release/[id]/route.ts,GET /api/press-release/<id>,fetchPressRelease,"Client-side proxy. catch -> 404. Consumers: PressReleaseItem, InfiniteArticleFeed"
    src/app/api/company-articles/[compID]/route.ts,GET /api/company-articles/<id>,fetchCompanyArticles,"catch -> [] with status 200, so failure is indistinguishable from 'no articles'"
    src/app/api/og/article/[id]/route.tsx,GET /api/og/article/<id>,fetchPressRelease,"ImageResponse 1200x630. Node runtime, no edge export. Duplicates the SITE_URL const instead of importing lib/metadata"
    src/app/api/ab/me/route.ts,GET /api/ab/me,getSession,"200 with { session: null } when anonymous. Was 401 until 2026-09-09, which put a console error on every page load for every visitor"
    src/app/api/ab/login/route.ts,POST /api/ab/login,verifyCredentials,"sets the signed session cookie"
    src/app/api/ab/logout/route.ts,POST /api/ab/logout,clearSessionCookie,"always ok"
    src/app/api/ab/experiments/route.ts,GET /api/ab/experiments?path=,findExperimentForPath,"401 without session. Always returns null today because EXPERIMENTS is empty"
    src/app/api/ab/vote/route.ts,"GET,POST /api/ab/vote","store.getVote, store.castVote","Deliberately never returns tallies to voters. 403 when the experiment is inactive. One editable vote per user per experiment"
    src/app/api/ab/admin/route.ts,GET /api/ab/admin,"EXPERIMENTS + store.getTally","403 for non-admins"
    src/app/api/ab/admin/toggle/route.ts,POST /api/ab/admin/toggle,store.setActive,"403 for non-admins"

services[12]{file,exports,upstream,on_error}:
  press-release.ts,fetchPressRelease,"new press-release/{id} AND legacy GetArticleById in parallel, merged","THROWS on non-ok primary. The legacy leg is enrichment only and is bounded by a 2s AbortSignal.timeout - Next does not cache failed responses, so without it every render re-waits on the 503 host"
  acn-adapter.ts,"adaptNewApiPressRelease, headlineToSlug, languageToSlug","none - pure transform","never throws; parseSectors swallows JSON.parse failures to []"
  news-list.ts,"fetchNewsList, fetchLatestNews, fetchArticlesByIndustry, fetchHeroSlides","new /api/articles/homepage and /api/Articles/by-industry","!ok -> [] but NO try/catch, so a network-level throw propagates"
  company-articles.ts,"fetchCompanyArticlesPage, fetchCompanyArticles","new /api/Articles/by-company/{id} ONLY - legacy path deleted 2026-09-08","never throws -> []. A page past the last answers 404, treated as no rows. hasNext probes page+1 with pageSize 1"
  company-profile.ts,fetchCompanyProfile,"new /api/Companies/{id}/full - ONE call, was two","never throws -> null. REWRITTEN 2026-09-23. /details is gone: its socials now arrive as a nested socials{} object and its address as named addressStreet/District/City fields. Contacts keys are name/phone/email, NOT the old contactName/contactPhone/contactEmail. Localised names come from names{} by language tag and logos arrive absolute. Distinguishes missing (404) from unreachable, as before"
  events.ts,"fetchEvents, fetchEvent, fetchEventReleases, eventYear, EVENT_TZ_LABEL","new /api/Events/full (list), /api/Events/{id}/full (detail), /api/Events/company/{id}/year/{year} (releases)","never throws -> [] / null. REWRITTEN 2026-09-23. Back on the fetch-call-site caching convention: /full returns 816 events in 286KB, under Next's 2MB ceiling, so the unstable_cache workaround the 2.65MB legacy sweep forced is GONE - React cache() alone dedupes within a render. The up-to-20-page sequential sweep is one request. The +08:00 stamping, url-scheme and image-host repair and organiser dedupe all still exist but are now no-ops the wire does upstream, kept only so a backend regression degrades instead of breaking"
  reading-mode.ts,"getReadingMode, getNextArticleId",new /api/Articles?Size=20,"-> null. revalidate 300 is set but it is CALLED FROM A CLIENT COMPONENT so the directive is ignored and the browser hits the external API directly"
  release-versions.ts,"fetchReleaseVersions, RELEASE_VERSIONS_SUPPORTED",none,"DECLARED STUB - always returns exactly [current]. Flag is false"
  search.ts,"searchArticles, getSectorDisplayName","none - imports src/data/prefetched-articles.json","synchronous, never throws"
  index.ts,getPressRelease,delegates,"DEAD FILE - zero importers"
  mock-press-release.ts,mockPressRelease,none,"DEAD - only index.ts imports it"
  acn-api.types.ts,"NewApiArticle, LegacyApiArticle, NewApiPressRelease",none,"wire types only, never leak past the adapters"

adapter:
  why: "The new API omits language, location, views, supplier, origin url, the full sector list and company socials, so fetchPressRelease calls BOTH hosts and merges."
  entry: src/services/acn-adapter.ts:43
  legacy_only_fields[5]: supplier,location,url,views,"language (without legacy every article canonicalises to /article/english/...)"
  quirks[4]{quirk,detail}:
    sectors_double_encoded,"New API sends sectors as a JSON-encoded STRING, parsed by parseSectors at acn-adapter.ts:23"
    field_name_chaos,"Two fields have four spellings across three endpoints: companyId/companyID/comp_ID and logoFilename/logoFileName/logofilename. news-list.ts:35,48 reads both casings defensively"
    bodyHtml_unsanitized,"acn-adapter.ts:64 is a bare ?? chain unlike every neighbouring field - see security section"
    stock_hardcoded,"acn-adapter.ts:80 pins stock to null"
  canonical_type_location: "src/types/press-release.ts declares PressReleaseData - the app's central article type lives in a COMPONENT folder and services import from it (inverted dependency)"

security:
  sanitization_split: "Regex-only server-side (lib/sanitize.ts, no DOM, serverless-safe); DOMPurify in the browser. The article BODY is sanitised TWICE against one shared allowlist: sanitizeArticleHtml during SSR, then DOMPurify after Body.tsx mounts. 'use client' does not keep a component off the server - calling DOMPurify there threw 'sanitize is not a function' and 500'd every article page once the API stopped 404ing them."
  only_dangerous_html: src/components/features/article/Body.tsx:29
  findings[3]{issue,where,detail}:
    bodyHtml_raw_in_rsc_payload,src/services/acn-adapter.ts:64,"bodyHtml still passes through the adapter unsanitized and is still returned raw by /api/press-release/{id}. As of 2026-09-08 the SSR payload IS filtered, because Body.tsx runs sanitizeArticleHtml server-side - but the adapter itself is unchanged, so any consumer that does not render through Body is still unprotected"
    credentials_in_public_api,"new API /api/Companies response","The response schema includes username and password fields on an unauthenticated endpoint. Should be stripped from the backend DTO - raise with the API team"
    readme_stale_on_sanitizer,README.md:29,"Still claims isomorphic-dompurify; commits bad2101/4433e24 replaced it with plain dompurify"

