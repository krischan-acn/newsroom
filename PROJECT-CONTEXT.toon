update_protocol:
  cadence: "twice monthly"
  next_review: 2026-09-21
  steps[6]{step,how}:
    1,"Re-probe api_health. Pull the endpoint list from https://development.acnnewswire.com/swagger/v1/swagger.json, then curl each one using REAL ids taken from the working list endpoints - otherwise a 404 from a missing record looks like breakage"
    2,"Re-read docs/api-schemas/_gaps.csv and update the gaps tally plus any promoted or closed blockers"
    3,"Run git log --oneline since meta.updated; update history and add any new routes, components or services"
    4,"Prune the blockers table. Remove fixed items outright - a stale CRITICAL is worse than no entry"
    5,"Rewrite current_steps in priority order. Delete completed steps rather than marking them done, so the list stays short enough to act on"
    6,"Bump meta.updated and meta.next_review"
  keep_honest[3]{rule,why}:
    verify_before_recording,"Probe or read the code rather than copying a previous claim forward - two entries in this file were wrong until re-probed"
    distinguish_known_from_found,"Mark whether a gap is documented in _gaps.csv or was found ad hoc, so the backend hand-off stays accurate"
    no_secrets,"Never record credentials, tokens or env values in this file - record the variable name and where it is read"
