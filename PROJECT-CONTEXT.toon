    nav/MainNav/Language/index.tsx,client,"Language menu showing label plus endonym","sets hrefLang and lang"
    nav/MainNav/types.ts,module,"MegaMenuItem and DEFAULT_MEGA_MENU_ITEMS, 9 tabs","MainNavProps and MegaMenuNavProps are never imported. Exchange and Stock Codes tabs have href # and no dropdown"
    nav/MainNav/MainNav.css,css,"nav-link and dropdown-link rules","GLOBAL stylesheet not a module. The .nav-button* rules are unused by any TSX"
    nav/TopNav/index.tsx,server,"Utility strip: language selector, centered clock, date, hidden A/B dot","a SERVER component composing 4 client children"
    nav/TopNav/DateTimeDisplay.tsx,client,"4-zone clock: IST, CST, SGT+HKT, KST+JST","renders placeholder dots pre-mount; minute-aligned setTimeout then setInterval"
    nav/TopNav/DateDisplay.tsx,client,"Today's date, re-armed at midnight","returns null pre-mount"
    nav/TopNav/LanguageSelector.tsx,client,"Globe dropdown to 5 external ACN domains","hover-intent timeout; outside-click. Re-implements the dropdown in Tailwind, ignoring TopNav.css rules"
    nav/TopNav/ClientLinks.tsx,client,"Clients/Journalists/Publishers links, collapsing under 1080px","ORPHAN - imported at TopNav/index.tsx:8 but its JSX is commented out at :43"
    nav/TopNav/types.ts,module,"Language and ClientLink types plus defaults","DEFAULT_CLIENT_LINKS feeds only the dead clientLinks prop"
    nav/TopNav/TopNav.css,css,"top-nav and global-dropdown rules","GLOBAL. Several rules unused since LanguageSelector went Tailwind"
  press_release[13]{file,type,purpose,notes}:
    press-release/PressRelease.tsx,server,"Full article shell: article column plus rail","also rendered INSIDE the client InfiniteArticleFeed, so it and its server children get bundled to the client on that path"
    press-release/Hero.tsx,client,"Headline, subhead, source/date/language block","client only for a useState in LogoMark"
    press-release/Body.tsx,client,"Renders the sanitized article HTML","THE ONLY dangerouslySetInnerHTML in the app. Client because dompurify needs a DOM. Explicit 33-tag / 12-attr allowlist, no style, no id, no handlers"
    press-release/Company.tsx,client,"About-the-company block with logo and website","useState logo error fallback"
    press-release/ArticleSidebar.tsx,server,"Article rail: released-by, summary, versions, details, topics, follow","dev-only amber Stub notice gated on RELEASE_VERSIONS_SUPPORTED and NODE_ENV"
    press-release/ArticleFooterLink.tsx,server,"acnnewswire.com footer link plus view count",-
    press-release/ShareBar.tsx,client,"LinkedIn / X / Email / Copy-link row","reads window.location.href in useEffect; 2s Copied state"
    press-release/MoreFromCompany.tsx,server,"Up to 3 sibling releases, excluding the current id","returns null when empty"
    press-release/PressReleaseItem.tsx,client,"The site's universal release row - logo, headline, meta, thumb","MOST REUSED list item: MoreFromCompany, SearchResults, /news, /company/<id>, event press-releases. Fetches /api/press-release/{id} to backfill a missing logo"
    press-release/InfiniteArticleFeed.tsx,client,"Infinite article reader that appends the next release and rewrites the URL on scroll","two IntersectionObservers, history.replaceState, loadedIds Set dedupe, loadingRef reentrancy guard. Observes #article-first-wrapper set by the route"
    press-release/ArticleMeta.tsx,server,"dl of topic, region, country, source, language, sectors","ORPHAN - removed from PressRelease (see its comment at :49-51) and rendered nowhere. Still carries hardcoded East Asia / Japan defaults"
    press-release/types.ts,module,"CompanyData, Location, PressReleaseData","The canonical article type lives HERE, not in services - services import upward from a component folder"
    press-release/index.tsx,module,"Barrel","OMITS ArticleSidebar and PressReleaseItem despite both being widely used via deep imports"
  search[4]{file,type,purpose,notes}:
    search/SearchSidebar.tsx,client,"Filter rail: sector/industry tree, language checkboxes, region tree","URL-driven, no local source of truth. Note the asymmetry: sector toggles expand to leaves and never store parents, region toggles DO store parents"
    search/SearchResults.tsx,server,"Result count line, list, pager","maps sectors through getArticleCategories and getSectorDisplayName"
    search/NestedCheckbox.tsx,client,"Recursive tri-state hierarchy checkbox","sets .indeterminate imperatively via ref; auto-opens when a child is selected"
    search/Pagination.tsx,client,"Prev / Page X of Y / Next","hardcodes the /search? target"
  ui[6]{file,type,purpose,notes}:
    ui/Rail.tsx,server,"Shared rail primitives: RailSection, RailRow, RailExternalLink plus RAIL_WIDTH/RAIL_PILL/RAIL_LINK consts","RailRow self-omits on null/undefined/empty - this is the mechanism behind every 'card omits itself' behaviour. Keeps the company and article rails dimensionally identical"
    ui/LanguageTag.tsx,client,"Language badge with hover tooltip and right-click details menu","MOST-REUSED LEAF, 7 call sites. Portaled; viewport-flip positioning; span role=button because it nests inside card-wide Links"
    ui/SocialLinks.tsx,server,"Rail social row, falls back to a text link when no glyph matches","10-key ICONS map, twitter maps to X"
    ui/Footer.tsx,server,"Global footer: logo, 5 link columns, 9 social icons, copyright","EVERY link is href=#. Zero Tailwind - pure Footer.css. Looks like a Webflow export"
    ui/Footer.css,css,"footer-* rules, 155 lines",-
    ui/SocialIcon.jsx,server,"Maps a platform string to an icon asset","the ONLY .jsx file in the tree, untyped. Declares a size prop that is never used, imports next/image without using it"

styling:
  approach: "Tailwind v4 utilities as the default, with 4 co-located GLOBAL stylesheets. No CSS Modules anywhere, so those class names leak app-wide."
  inconsistencies[6]{issue,detail}:
    accent_three_ways,"var(--accent-color) in ab and MainNav.css, literal #2088c9 in events/search/press-release/home, and #2563eb or blue-600 in .nav-link.active and the MainNav search focus ring"
    footer_no_tailwind,"ui/Footer.tsx uses pure .footer-* global CSS with zero Tailwind - the single largest inconsistency in the tree"
    two_button_systems,".button and .button.alt live in globals.css as the de-facto shared button, but MainNav styles its Login/Register pills with raw Tailwind instead"
    dead_class_names,".megamenu-title and .dropdown-menu-section are used in JSX but defined in no stylesheet. Conversely .nav-button*, .global-dropdown-menu*, .nav-middle and .separator are defined but unused"
    image_strategy_split,"raw img with an eslint-disable in CategoryRow, EventsRow, FeaturedReleases, PressReleaseItem, CompanySidebar, ArticleSidebar, SocialLinks, SocialIcon and Footer, versus next/image in HomeHero, press-release/Hero, press-release/Company and the MainNav logo"
    globals_css_typo,"src/app/globals.css:7 defines --text-csolor while body reads var(--text-color), so the variable never resolves. Dark-mode block is commented out at :19-26"

next_config[3]{setting,value,note}:
  headers,"/_next/image gets Content-Disposition: inline",-
  redirects,"/companies/:id -> /company/:id (permanent); /companies and /company -> / (temporary)","FIXED 2026-09-09. /companies used to 308 into /company, which has no page.tsx and so 404'd. Both bare paths now land on the homepage until a company directory exists"
  images.remotePatterns,"www.acnnewswire.com/images/company/** and photos.acnnewswire.com/**","www.acnnewswire.com/eventimages is used by events.ts but NOT whitelisted"

ab_testing:
  what: "Employee-only A/B compare-and-vote overlay, opened with F2 or a hidden dot in the TopNav."
  status: "Framework COMPLETE and wired into the site shell. ZERO experiments registered, so it is inert everywhere."
  built_in_commit: ad42ca1
  working[6]{piece,where}:
    auth,"src/ab/config.ts, token.ts (HMAC-SHA256 + timingSafeEqual), session.ts"
    storage,"src/ab/store.ts picks Upstash Redis when env is set, else src/ab/store.local.ts writing .ab-data/store.json with a write queue"
    api,"7 routes under src/app/api/ab/ - all session-gated and validated"
    vote_ui,"src/components/ab/AbOverlay.tsx - a/b/side-by-side/slider modes plus Prefer A/B buttons with optimistic update"
    results_ui,"src/app/admin/AdminPanel.tsx - live A vs B bars, percentages, per-experiment on/off toggle"
    mounting,"src/app/layout.tsx renders AbOverlay in Suspense; TopNav renders the hidden trigger"
  missing[4]{gap,where}:
    no_experiments,"src/ab/experiments.ts:27-35 - EXPERIMENTS is an empty array with only a commented example, so findExperimentForPath always returns null and every page shows 'No experiment on this page'"
    no_variant_css,"public/ab-variants/ holds only README.md - no <id>.css exists"
    no_targets,"No page markup anywhere carries a data-ab-target attribute, so a variant stylesheet would have nothing to hook"
    no_votes_yet,".ab-data/ does not exist and Upstash is unconfigured - nobody has voted, even locally"
  to_activate[3]{step,detail}:
    1,"Add an entry to EXPERIMENTS in src/ab/experiments.ts"
    2,"Author public/ab-variants/<id>.css"
    3,"Add data-ab-target to the markup the variant should restyle"

