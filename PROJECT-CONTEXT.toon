    nav/MainNav/MegaMenuNav.tsx,client,"Mega-menu tab bar and height-animated dropdown shell","useLayoutEffect plus ResizeObserver measurement. Declares its own local props type"
    nav/MainNav/Company/index.tsx,client,"Company mega-menu: region columns plus A-Z index","FULLY STUBBED - placeholder One..Five, every href is #"
    nav/MainNav/Country/index.tsx,client,"Country menu grouped continent > subregion > country","BROKEN LINKS - points at /search?country= which the search page never parses, so results are unfiltered"
    nav/MainNav/Industry/index.tsx,client,"Industry menu grouped by sector_type, links to /search?sec=",-
    nav/MainNav/Sector/index.tsx,client,"Top-level sector menu, links to /search?sec=","duplicates the toSectionParam helper from Industry"
